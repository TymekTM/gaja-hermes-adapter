# Wi-Fi (2.4 GHz only on the ESP32-S3)
wifi_ssid: "your-2.4GHz-ssid"
wifi_password: "..."

# Fallback AP (wrong Wi-Fi password recovery) and OTA
ap_password: "..."
ota_password: "..."

# Gaja device protocol (docs/DEVICE.md). Create the token on the server host:
#   uv run python scripts/device_token.py <device_id> --name "<friendly name>"
# The token is printed ONCE and stored (mode 600) in ~/.config/gaja/devices.toml on the server.
gaja_server_url: "ws://192.168.0.10:8792/device"
gaja_device_id: "atom-salon"
gaja_device_token: "paste-the-printed-token"
